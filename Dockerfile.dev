# syntax=docker/dockerfile:1
# Development image: source is bind-mounted and Air rebuilds on change.
# Used by docker-compose.dev.yml — not for production.

FROM golang:1.26-alpine

RUN apk add --no-cache git ca-certificates tzdata wget

# Air watches the bind-mounted source and rebuilds the binary in place.
RUN go install github.com/air-verse/air@latest

WORKDIR /src

# Warm the module cache at build time so the first `air` run isn't a cold start.
COPY go.mod go.sum ./
RUN go mod download

# Source arrives via the bind mount in docker-compose.dev.yml.
EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
