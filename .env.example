# ---- App ----
APP_ENV=development          # development | staging | production
APP_PORT=8080

# Comma-separated CIDRs/IPs of reverse proxies allowed to set X-Forwarded-For.
# EMPTY = trust nothing (client IP is the direct peer). Only fill this in if a
# proxy really sits in front of the app; otherwise clients can spoof their IP
# and bypass the rate limiter. Behind nginx in Docker: 172.16.0.0/12
TRUSTED_PROXIES=

# Host port mappings used by docker compose (container ports stay fixed).
APP_HOST_PORT=8080
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ---- HTTP server ----
HTTP_READ_HEADER_TIMEOUT=5s  # slowloris guard
HTTP_MAX_HEADER_BYTES=1048576
HTTP_MAX_BODY_BYTES=1048576  # 1 MiB; larger bodies get a 413
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=app
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true         # run pending migrations on startup
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAXMEMORY=256mb

# ---- Sessions (server-side, stored in Redis) ----
SESSION_COOKIE_NAME=session_id
SESSION_TTL=24h
SESSION_COOKIE_SECURE=false      # set true in production (HTTPS only)
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_PATH=/
SESSION_COOKIE_SAMESITE=lax      # lax | strict | none

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300

# ---- Rate limiting (fixed window, per IP, Redis-backed) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ---- Metrics (Prometheus) ----
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ---- Logging ----
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=text              # text | json  (use json in production)
